{
  "expo": {
    "name": "AVEN",
    "slug": "aven-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/aven-icon.png",
    "scheme": "aven",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tarunk951.aven"
    },
    "android": {
      "package": "com.tarunk951.aven",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/aven-adaptive.png",
        "backgroundColor": "#282a2d"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/aven-icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f3f3f3",
          "image": "./assets/images/aven-splash.png",
          "imageWidth": 120
        }
      ],
      "./plugins/withBuildSettings"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
